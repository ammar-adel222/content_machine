# Gemini TTS (model cascade, voice, and tone are managed in code and blueprint.json)
GEMINI_API_KEY=

# YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRETS_FILE=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
YOUTUBE_DEFAULT_PRIVACY=private

# Instagram Graph API (Reels)
IG_ACCESS_TOKEN=
IG_USER_ID=
# IG_STAGING_PROVIDER options: none | r2 | s3 | public_url
IG_STAGING_PROVIDER=none
IG_STAGING_PUBLIC_BASE_URL=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
