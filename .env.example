# Gemini TTS
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Charon
GEMINI_TTS_STYLE_PROMPT="Confident, crisp, engaging tech explainer pacing with subtle dramatic emphasis on failures and upgrades."

# YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRETS_FILE=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
YOUTUBE_DEFAULT_PRIVACY=private

# Instagram Graph API (Reels)
IG_ACCESS_TOKEN=
IG_USER_ID=
# IG_STAGING_PROVIDER options: none | r2 | s3 | public_url
IG_STAGING_PROVIDER=none
IG_STAGING_PUBLIC_BASE_URL=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
